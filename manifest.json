{
  "manifest_version": 3,
  "name": "OpenFront Enhanced",
  "version": "0.6.0",
  "description": "Optimal troop management for OpenFront: smart 40% slider, per-neighbor attack-readiness badges, and $/min building labels.",
  "permissions": [],
  "host_permissions": [
    "*://openfront.io/*",
    "*://www.openfront.io/*",
    "*://openfront.dev/*",
    "*://www.openfront.dev/*",
    "*://*.openfront.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://openfront.io/*",
        "*://www.openfront.io/*",
        "*://openfront.dev/*",
        "*://www.openfront.dev/*",
        "*://*.openfront.dev/*"
      ],
      "js": [
        "src/pagehook/namespace.js",
        "src/pagehook/constants.js",
        "src/pagehook/native-overrides.js",
        "src/pagehook/utils.js",
        "src/pagehook/keybinds.js",
        "src/pagehook/settings-ui.js",
        "src/pagehook/alliance-panel.js",
        "src/pagehook/events-panel.js",
        "src/pagehook/game-hooks.js",
        "src/pagehook/troop-graph.js",
        "src/pagehook/econ-markers.js",
        "src/pagehook/attack-ready.js",
        "src/pagehook/neighbor-watch.js",
        "src/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://openfront.io/*",
        "*://www.openfront.io/*",
        "*://openfront.dev/*",
        "*://www.openfront.dev/*",
        "*://*.openfront.dev/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "OpenFront Enhanced"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}